# ---------- domain / TLS ----------
DOMAIN=tubelead.example.com
ACME_EMAIL=you@example.com

# ---------- Supabase (Auth + Postgres) ----------
SUPABASE_URL=https://YOUR-REF.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=
# Direct/pooler Postgres URI. Run supabase/migrations/001_init.sql then 002_tubelead.sql first.
DATABASE_URL=postgresql+psycopg://postgres:PASSWORD@db.YOUR-REF.supabase.co:5432/postgres

# ---------- secrets (generate each: openssl rand -hex 32) ----------
SECRET_KEY=
# ---------- YouTube ----------
YOUTUBE_API_KEY=
YOUTUBE_DAILY_QUOTA=10000
YOUTUBE_QUOTA_RESERVE=300
# ---------- Stripe ----------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_ANNUAL=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_ELITE_MONTHLY=
STRIPE_PRICE_ELITE_ANNUAL=
# ---------- optional ----------
N8N_WEBHOOK_URL=
MAX_CONCURRENT_JOBS=2
