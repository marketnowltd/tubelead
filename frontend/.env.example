# ---- TubeLead frontend (copy to frontend/.env.local) ----
# Where the Next.js server proxies /api/* to. Read at BUILD time (it is baked into the rewrite rules).
BACKEND_URL=http://127.0.0.1:8000

# Only needed when the backend runs with AUTH_MODE=supabase. These two are public by design (anon key).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public site URL (metadata / Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
