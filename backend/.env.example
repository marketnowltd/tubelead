# ---- TubeLead backend (copy to backend/.env) ----
ENVIRONMENT=development

# Database. SQLite works out of the box for local development.
# Production (Supabase): run supabase/migrations/001_init.sql then 002_tubelead.sql, then use the direct/pooler connection string:
# DATABASE_URL=postgresql+psycopg://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
DATABASE_URL=sqlite:///./tubelead.db

# YouTube Data API v3 key (Google Cloud Console -> APIs & Services -> Credentials). SERVER-SIDE ONLY.
YOUTUBE_API_KEY=
YOUTUBE_DAILY_QUOTA=10000      # your project's daily quota (default free tier = 10,000 units)
YOUTUBE_QUOTA_RESERVE=300      # units never spent by discovery

# Auth: "dev" = one local user, no login. "supabase" = require a Supabase JWT (or X-API-Key).
AUTH_MODE=dev
SUPABASE_URL=
SUPABASE_JWT_SECRET=           # Supabase dashboard -> Settings -> API -> JWT secret

# Comma-separated origins allowed to call the API directly (the Next.js app proxies /api, so usually not needed)
CORS_ORIGINS=http://localhost:3000

# Optional
REDIS_URL=                     # shared rate limiting across workers, e.g. redis://localhost:6379/0
N8N_WEBHOOK_URL=               # default webhook for job events (users can override in the UI)
RATE_LIMIT_PER_MINUTE=300
MAX_CONCURRENT_JOBS=2
FETCH_WEBSITES=true            # fetch creators' public websites/contact pages for business emails
SCHEDULER_ENABLED=true

# ---- TubeLead additions ----
# Encrypts AI provider keys at rest. REQUIRED in production: a long random string (e.g. `openssl rand -hex 32`).
# Changing it makes previously stored provider keys undecryptable (users must re-enter them).
SECRET_KEY=change-me-to-a-long-random-string
# Public URL of the app (Stripe Checkout/portal return links)
APP_BASE_URL=http://localhost:3000
# Set false on multi-tenant deployments so users cannot point AI providers at loopback/private addresses
AI_ALLOW_PRIVATE_HOSTS=true

# Stripe (billing). Plans unlock ONLY from signature-verified webhooks.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_ANNUAL=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_ELITE_MONTHLY=
STRIPE_PRICE_ELITE_ANNUAL=
# Optional JSON overriding plan prices/allowances, e.g. {"pro": {"leads": 30000}}
PLANS_FILE=
# DEV ONLY (ignored unless AUTH_MODE=dev): evaluate paid features locally without Stripe, e.g. PLAN_OVERRIDE=elite
PLAN_OVERRIDE=

# Support assistant (OpenAI). Server-side only. Without it the assistant answers from help articles only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Days to keep chat conversations that did not become support tickets
CHAT_RETENTION_DAYS=180
# Transactional email (Resend). Without a key, emails are stored as "not configured" and visible in Admin > System.
RESEND_API_KEY=
EMAIL_FROM=TubeLead <support@tubelead.app>
ADMIN_ALERT_EMAIL=
# Optional: lets self-service account deletion also remove the Supabase sign-in record
SUPABASE_SERVICE_ROLE_KEY=
# Comma-separated Supabase user IDs with full admin access (the site owner)
OPERATOR_USER_IDS=

# Growth Assistant (server-side; customers never configure these)
PUBLIC_API_URL=                 # e.g. https://tubelead-api.onrender.com (hosted email images)
SNOV_CLIENT_ID=                 # TubeLead's own Snov.io account for enrichment + verification
SNOV_CLIENT_SECRET=
SNOV_COST_PER_CREDIT_PENCE=0    # for Admin > Growth & plans margin reporting
BRAVE_API_KEY=                  # Brave Search API (web discovery)
BRAVE_COST_PER_QUERY_PENCE=0
